# ===== TELEGRAM BOT CONFIGURATION =====
# Telegram API Credentials (Get from https://my.telegram.org)
API_ID=your_api_id_here
API_HASH=your_api_hash_here
BOT_TOKEN=your_bot_token_here

# Administrator / Bot Owner Telegram Numeric User ID (Mandatory)
ADMIN_ID=your_telegram_user_id_here

# Channel Configuration
CHANNEL_ID=-1001234567890
SESSION_NAME=self_destruct

# ===== ACCESS CONTROL =====
# Optional comma-separated Telegram User IDs allowed to use the bot
# Example: ALLOWED_USERS=123456789,987654321
ALLOWED_USERS=

# ===== ENCRYPTION KEYS (GENERATE WITH: python3 generate_key.py) =====
DB_ENCRYPTION_KEY=64_char_hex_random_string_here
ENCRYPTION_KEY=32_byte_base64_fernet_key_here

# ===== ADVANCED SETTINGS =====
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Max file size in bytes (2GB default)
MAX_FILE_SIZE=2147483648

# Queue & Background Task Settings (in seconds)
QUEUE_INTERVAL=300
AUTOCHECK_INTERVAL=3600
MAX_RETRIES=3
